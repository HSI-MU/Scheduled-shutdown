<Window x:Class="OnTimeShutdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnTimeShutdown.Controls"
        Title="准点关机"
        Width="480"
        Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="Assets/app.ico"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#23262D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#85837E" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#A6A29A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E96D36" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF1E8" />
        <SolidColorBrush x:Key="LineBrush" Color="#EDE9E2" />
        <SolidColorBrush x:Key="FieldBrush" Color="#F7F5F0" />

        <DropShadowEffect x:Key="CardShadow"
                          Color="#5D4C3A"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.08" />

        <Style x:Key="ValueInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="29" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,-2,0,0" />
            <Setter Property="MaxLength" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#F4C5AA" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="IBeam" />
            <EventSetter Event="GotKeyboardFocus" Handler="ValueInput_GotKeyboardFocus" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ValueInput_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewTextInput" Handler="ValueInput_PreviewTextInput" />
            <EventSetter Event="LostKeyboardFocus" Handler="ValueInput_LostKeyboardFocus" />
            <EventSetter Event="PreviewKeyDown" Handler="ValueInput_PreviewKeyDown" />
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#716E68" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEEAE3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E4DED5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#C74E3D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#7E7B75" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#F3F0EA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DateChipStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#77736C" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="#F7F4EE"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1EDE5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F6D2BD" />
                                <Setter Property="Foreground" Value="#D8622E" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpinnerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#96918A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E9E4DB" />
                                <Setter Property="Foreground" Value="#5E5A54" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DED7CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickChipStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#F8F5F0" />
            <Setter Property="BorderBrush" Value="#EEE9E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#6E6A63" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFF3EA" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F4D6C4" />
                                <Setter Property="Foreground" Value="#D46633" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FCE8DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#F69258" />
                        <GradientStop Offset="1" Color="#E86530" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#E86B36"
                                                  BlurRadius="16"
                                                  ShadowDepth="5"
                                                  Opacity="0.28" />
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="HoverLayer"
                                        Background="White"
                                        CornerRadius="15"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.10" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.18" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerActionStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Foreground" Value="#B84C38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Background" Value="#FCF4F0" />
            <Setter Property="BorderBrush" Value="#EAD7CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#A87865"
                                                  BlurRadius="14"
                                                  ShadowDepth="4"
                                                  Opacity="0.10" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F9E9E2" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#DFC2B5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F3DED5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="OuterGrid" Margin="14" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="OuterSlide" Y="8" />
        </Grid.RenderTransform>

        <Border x:Name="Shell"
                Background="#F7F5F1"
                BorderBrush="#E8E3DA"
                BorderThickness="1"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect Color="#241A12"
                                  BlurRadius="24"
                                  ShadowDepth="6"
                                  Opacity="0.20" />
            </Border.Effect>

            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="164" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="286" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="14" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="37"
                            Height="37"
                            CornerRadius="11"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#F9A36E" />
                                <GradientStop Offset="1" Color="#E96631" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#E76C36"
                                              BlurRadius="10"
                                              ShadowDepth="2"
                                              Opacity="0.28" />
                        </Border.Effect>
                        <TextBlock Text="&#xE7E8;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="11,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="准点关机"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="SHUTDOWN TIMER"
                                   Margin="0,1,0,0"
                                   FontFamily="Bahnschrift"
                                   FontSize="8"
                                   Foreground="#9A958C" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButtonStyle}"
                                Content="&#xE921;"
                                ToolTip="最小化"
                                AutomationProperties.Name="最小化"
                                Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Content="&#xE8BB;"
                                Margin="3,0,0,0"
                                ToolTip="关闭"
                                AutomationProperties.Name="关闭"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Hero -->
                <Border Grid.Row="2"
                        CornerRadius="20"
                        ClipToBounds="True">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,404,164" RadiusX="20" RadiusY="20" />
                    </Border.Clip>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#1D2637" />
                            <GradientStop Offset="0.62" Color="#263249" />
                            <GradientStop Offset="1" Color="#303B52" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Ellipse Width="250"
                                 Height="250"
                                 Fill="#0DFFFFFF"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-120,-70,0" />
                        <Ellipse Width="160"
                                 Height="160"
                                 Fill="#08FFFFFF"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,-50,-70" />
                        <Ellipse Width="3"
                                 Height="3"
                                 Fill="#55FFD5AF"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,31,158,0" />
                        <Ellipse Width="2"
                                 Height="2"
                                 Fill="#44FFFFFF"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,57,124,0" />

                        <Grid Margin="22,18,18,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <Border Background="#14FFFFFF"
                                        CornerRadius="9"
                                        Padding="8,4"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HeroStatusDot"
                                                 Width="6"
                                                 Height="6"
                                                 Fill="#F0B37F"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="HeroStatusText"
                                                   Text="等待设定"
                                                   Margin="6,0,0,0"
                                                   FontSize="10"
                                                   Foreground="#DDDCE1" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="CountdownText"
                                           Text="待设置"
                                           Margin="0,8,0,0"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock x:Name="HeroHintText"
                                           Text="选择一个时间，让电脑到点休息"
                                           Margin="1,3,8,0"
                                           FontSize="10.5"
                                           Foreground="#AEB8CA"
                                           TextWrapping="Wrap"
                                           LineHeight="15" />
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <controls:ProgressRing x:Name="CountdownRing"
                                                       Width="106"
                                                       Height="106"
                                                       Progress="0"
                                                       StrokeThickness="8"
                                                       RingBrush="#F4A76E"
                                                       TrackBrush="#24FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7E8;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="21"
                                               Foreground="#FFC595"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RingCaption"
                                               Text="待机"
                                               Margin="0,1,0,0"
                                               FontSize="8.5"
                                               Foreground="#AEB8CA"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Setup state -->
                <Grid x:Name="SetupArea" Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="234" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#ECE8E1"
                            CornerRadius="13"
                            Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="TimeTab"
                                         Style="{StaticResource SegmentRadioStyle}"
                                         GroupName="Mode"
                                         Content="指定时间"
                                         IsChecked="True"
                                         Checked="ModeTab_Checked" />
                            <RadioButton x:Name="CountdownTab"
                                         Grid.Column="1"
                                         Style="{StaticResource SegmentRadioStyle}"
                                         GroupName="Mode"
                                         Content="倒计时"
                                         Checked="ModeTab_Checked" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#ECE7DE"
                            BorderThickness="1"
                            CornerRadius="18"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <!-- Absolute time panel -->
                            <Grid x:Name="TimePanel" Margin="18,15,18,13">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="76" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="选择关机时间"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <RadioButton x:Name="TodayChip"
                                                     Style="{StaticResource DateChipStyle}"
                                                     GroupName="Date"
                                                     Content="今天"
                                                     IsChecked="True"
                                                     Checked="DateChip_Checked"
                                                     Tag="today" />
                                        <RadioButton x:Name="TomorrowChip"
                                                     Style="{StaticResource DateChipStyle}"
                                                     GroupName="Date"
                                                     Content="明天"
                                                     Margin="5,0,0,0"
                                                     Checked="DateChip_Checked"
                                                     Tag="tomorrow" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="154"
                                            Height="76"
                                            Background="{StaticResource FieldBrush}"
                                            BorderBrush="#EDE8DF"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            PreviewMouseWheel="HourField_MouseWheel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="小时"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource SubtleBrush}" />
                                                <TextBox x:Name="HourValueText"
                                                         Style="{StaticResource ValueInputStyle}"
                                                         Text="02"
                                                         AutomationProperties.Name="小时，可直接输入" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="0,1,6,0">
                                                <Button Style="{StaticResource SpinnerButtonStyle}"
                                                        Content="&#xE70E;"
                                                        Click="HourUp_Click" />
                                                <Button Style="{StaticResource SpinnerButtonStyle}"
                                                        Content="&#xE70D;"
                                                        Height="21"
                                                        Click="HourDown_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text=":"
                                               Margin="7,0,7,2"
                                               FontFamily="{StaticResource NumberFont}"
                                               FontSize="27"
                                               Foreground="#AAA49A"
                                               VerticalAlignment="Center" />

                                    <Border Width="154"
                                            Height="76"
                                            Background="{StaticResource FieldBrush}"
                                            BorderBrush="#EDE8DF"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            PreviewMouseWheel="MinuteField_MouseWheel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="分钟"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource SubtleBrush}" />
                                                <TextBox x:Name="MinuteValueText"
                                                         Style="{StaticResource ValueInputStyle}"
                                                         Text="00"
                                                         AutomationProperties.Name="分钟，可直接输入" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="0,1,6,0">
                                                <Button Style="{StaticResource SpinnerButtonStyle}"
                                                        Content="&#xE70E;"
                                                        Click="MinuteUp_Click" />
                                                <Button Style="{StaticResource SpinnerButtonStyle}"
                                                        Content="&#xE70D;"
                                                        Height="21"
                                                        Click="MinuteDown_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <UniformGrid Grid.Row="4" Columns="4">
                                    <Button Style="{StaticResource QuickChipStyle}"
                                            Content="22:00"
                                            Margin="0,0,3,0"
                                            Tag="22:00"
                                            Click="TimePreset_Click" />
                                    <Button Style="{StaticResource QuickChipStyle}"
                                            Content="23:00"
                                            Margin="3,0,3,0"
                                            Tag="23:00"
                                            Click="TimePreset_Click" />
                                    <Button Style="{StaticResource QuickChipStyle}"
                                            Content="00:00"
                                            Margin="3,0,3,0"
                                            Tag="00:00"
                                            Click="TimePreset_Click" />
                                    <Button Style="{StaticResource QuickChipStyle}"
                                            Content="07:00"
                                            Margin="3,0,0,0"
                                            Tag="07:00"
                                            Click="TimePreset_Click" />
                                </UniformGrid>

                                <Border Grid.Row="6"
                                        Background="#FAF7F1"
                                        CornerRadius="10"
                                        Padding="11,0">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#xE823;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="11"
                                                   Foreground="#B27C58"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="TimeTargetText"
                                                   Text="将在 今天 22:00 关机"
                                                   Margin="7,0,0,0"
                                                   FontSize="10.5"
                                                   Foreground="#7A7268"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Countdown panel -->
                            <Grid x:Name="CountdownPanel"
                                  Margin="18,15,18,13"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="76" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="设置关机倒计时"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="最长 99 小时"
                                               FontSize="10"
                                               Foreground="{StaticResource SubtleBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="154"
                                            Height="76"
                                            Background="{StaticResource FieldBrush}"
                                            BorderBrush="#EDE8DF"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            PreviewMouseWheel="DurationHourField_MouseWheel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="小时"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource SubtleBrush}" />
                                                <TextBox x:Name="DurationHourValueText"
                                                         Style="{StaticResource ValueInputStyle}"
                                                         Text="00"
                                                         AutomationProperties.Name="小时数，可直接输入" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="0,1,6,0">
                                                <Button Style="{StaticResource SpinnerButtonStyle}"
                                                        Content="&#xE70E;"
                                                        Click="DurationHourUp_Click" />
                                                <Button Style="{StaticResource SpinnerButtonStyle}"
                                                        Content="&#xE70D;"
                                                        Height="21"
                                                        Click="DurationHourDown_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text=":"
                                               Margin="7,0,7,2"
                                               FontFamily="{StaticResource NumberFont}"
                                               FontSize="27"
                                               Foreground="#AAA49A"
                                               VerticalAlignment="Center" />

                                    <Border Width="154"
                                            Height="76"
                                            Background="{StaticResource FieldBrush}"
                                            BorderBrush="#EDE8DF"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            PreviewMouseWheel="DurationMinuteField_MouseWheel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="分钟"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource SubtleBrush}" />
                                                <TextBox x:Name="DurationMinuteValueText"
                                                         Style="{StaticResource ValueInputStyle}"
                                                         Text="30"
                                                         AutomationProperties.Name="分钟数，可直接输入" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="0,1,6,0">
                                                <Button Style="{StaticResource SpinnerButtonStyle}"
                                                        Content="&#xE70E;"
                                                        Click="DurationMinuteUp_Click" />
                                                <Button Style="{StaticResource SpinnerButtonStyle}"
                                                        Content="&#xE70D;"
                                                        Height="21"
                                                        Click="DurationMinuteDown_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <UniformGrid Grid.Row="4" Columns="4">
                                    <Button Style="{StaticResource QuickChipStyle}"
                                            Content="15 分钟"
                                            Margin="0,0,3,0"
                                            Tag="15"
                                            Click="DurationPreset_Click" />
                                    <Button Style="{StaticResource QuickChipStyle}"
                                            Content="30 分钟"
                                            Margin="3,0,3,0"
                                            Tag="30"
                                            Click="DurationPreset_Click" />
                                    <Button Style="{StaticResource QuickChipStyle}"
                                            Content="1 小时"
                                            Margin="3,0,3,0"
                                            Tag="60"
                                            Click="DurationPreset_Click" />
                                    <Button Style="{StaticResource QuickChipStyle}"
                                            Content="2 小时"
                                            Margin="3,0,0,0"
                                            Tag="120"
                                            Click="DurationPreset_Click" />
                                </UniformGrid>

                                <Border Grid.Row="6"
                                        Background="#FAF7F1"
                                        CornerRadius="10"
                                        Padding="11,0">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#xE823;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="11"
                                                   Foreground="#B27C58"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="CountdownTargetText"
                                                   Text="预计 今天 01:46 关机"
                                                   Margin="7,0,0,0"
                                                   FontSize="10.5"
                                                   Foreground="#7A7268"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Active state -->
                <Border x:Name="ActiveArea"
                        Grid.Row="4"
                        Background="White"
                        BorderBrush="#ECE7DE"
                        BorderThickness="1"
                        CornerRadius="18"
                        Visibility="Collapsed"
                        Effect="{StaticResource CardShadow}">
                    <Grid Margin="18,16,18,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="84" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#51B98A"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="计划详情"
                                           Margin="7,0,0,0"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    Background="#EDF8F2"
                                    CornerRadius="8"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="系统已接管"
                                           FontSize="9.5"
                                           Foreground="#2F8C65" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#FBF7F1"
                                CornerRadius="13"
                                Padding="15,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="将在此时关机"
                                               FontSize="9.5"
                                               Foreground="#9B9388" />
                                    <TextBlock x:Name="ActiveTargetDateText"
                                               Text="今天 · 10月30日 周四"
                                               Margin="0,2,0,0"
                                               FontSize="10.5"
                                               Foreground="#7B746B" />
                                    <TextBlock x:Name="ActiveTargetTimeText"
                                               Text="22:00"
                                               Margin="0,-3,0,0"
                                               FontFamily="{StaticResource NumberFont}"
                                               FontSize="27"
                                               FontWeight="SemiBold"
                                               Foreground="#2A2D34" />
                                </StackPanel>
                                <Border Width="38"
                                        Height="38"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#FFF0E6"
                                        CornerRadius="11">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="16"
                                               Foreground="#DD743F"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <TextBlock Text="安排方式"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ActiveModeText"
                                       Text="指定时间"
                                       FontSize="10.5"
                                       Foreground="#44413C"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="6">
                            <TextBlock Text="剩余时间"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ActiveRemainingText"
                                       Text="00:30:00"
                                       FontFamily="{StaticResource NumberFont}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#44413C"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="8" Height="1" Background="#F0ECE4" />

                        <StackPanel Grid.Row="10"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="11"
                                       Foreground="#B28B6E"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="关闭窗口会最小化到托盘，关机计划继续执行"
                                       Margin="7,0,0,0"
                                       FontSize="10"
                                       Foreground="#8B847A"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main action -->
                <Button x:Name="ActionButton"
                        Grid.Row="6"
                        Style="{StaticResource PrimaryActionStyle}"
                        Click="ActionButton_Click"
                        AutomationProperties.Name="安排关机">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ActionGlyph"
                                   Text="&#xE7E8;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ActionText"
                                   Text="安排关机"
                                   Margin="8,0,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="8">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="4"
                                 Height="4"
                                 Fill="#B9B3A9"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterText"
                                   Text="系统级定时 · 关闭窗口即退出"
                                   Margin="6,0,0,0"
                                   FontSize="9.5"
                                   Foreground="#9B958C"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Toast -->
                <Border x:Name="Toast"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        Panel.ZIndex="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="12,0,12,76"
                        Padding="14,10"
                        Background="#272C35"
                        CornerRadius="12"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#1C1712"
                                          BlurRadius="18"
                                          ShadowDepth="5"
                                          Opacity="0.28" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastIcon"
                                   Text="&#xE946;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="#FFC08D"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastText"
                                   Text=""
                                   Margin="8,0,0,0"
                                   MaxWidth="330"
                                   FontSize="10.5"
                                   Foreground="#F7F5F1"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
