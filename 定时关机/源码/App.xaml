<Application x:Class="OnTimeShutdown.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="NumberFont">Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
